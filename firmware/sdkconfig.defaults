# Fosi MD3 hardware and application configuration (ESP-IDF 5.5.1)
CONFIG_ESPTOOLPY_FLASHMODE_DIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
# 160 MHz is plenty for one screen and an I2C link; with PM_ENABLE the CPU drops to 80 MHz when
# nothing holds a CPU_FREQ_MAX lock (main.c). APB stays at 80 MHz at both speeds on the S3, so I2C,
# SPI, LEDC and USB timing are unaffected. Automatic light sleep stays off (FREERTOS_USE_TICKLESS_IDLE).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_PM_ENABLE=y

# Keep the factory layout: app at 0x10000, storage at 0x910000, user_dat at 0x1f10000.
CONFIG_PARTITION_TABLE_SINGLE_APP=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# ESP32-S3R8: 8 MiB octal PSRAM. Large LVGL allocations may use it.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=16384
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768

# LVGL 9: C malloc integrates with SPIRAM; enable exactly what the UI uses.
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_USE_GIF=n
CONFIG_LV_USE_SNAPSHOT=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_28=y

# Factory FAT volume compatibility and the IDF 5.5 I2C-slave v2 API.
CONFIG_FATFS_LFN_NONE=n
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_SECTOR_4096=y
CONFIG_WL_SECTOR_SIZE_4096=y
CONFIG_I2C_ENABLE_SLAVE_DRIVER_VERSION_2=y

# Photo Sync: full-speed TinyUSB MSC with 4 KiB sectors and the stock identity.
CONFIG_TINYUSB_RHPORT_FS=y
CONFIG_TINYUSB_MSC_ENABLED=y
CONFIG_TINYUSB_MSC_BUFSIZE=4096
CONFIG_TINYUSB_MSC_MOUNT_PATH="/disk"
CONFIG_TINYUSB_DESC_MANUFACTURER_STRING="SD"
CONFIG_TINYUSB_DESC_PRODUCT_STRING="Fosi Audio MD3"
CONFIG_TINYUSB_DESC_SERIAL_STRING="123456"
CONFIG_TINYUSB_DESC_BCD_DEVICE=0x0100
CONFIG_TINYUSB_DESC_MSC_STRING="Fosi Audio MD3"
CONFIG_TINYUSB_FAT_FORMAT_ANY=n
CONFIG_TINYUSB_FAT_FORMAT_FAT=n
CONFIG_TINYUSB_FAT_FORMAT_FAT32=n
CONFIG_TINYUSB_FAT_FORMAT_EXFAT=n
CONFIG_TINYUSB_FAT_FORMAT_SFD=n

# Match the stock RTOS tick used by the reverse-engineered timings.
CONFIG_FREERTOS_HZ=100

# No radios: on this unit neither Wi-Fi nor Bluetooth was ever heard (docs/limits.md). Bluetooth
# is off here; Wi-Fi has no Kconfig switch on this target, so main/ simply no longer requires
# esp_wifi, lwIP or the HTTP server, and nothing ever starts the RF front end.
CONFIG_BT_ENABLED=n

# The USB control channel renders screenshots (lv_snapshot_take) on the TinyUSB task.
CONFIG_TINYUSB_TASK_STACK_SIZE=8192
